<Window x:Class="DadwayVPN.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dadway VPN 2.0" Width="1080" Height="760" MinWidth="940" MinHeight="680" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" Icon="Assets/dadway.ico">
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="2.35*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,20,0">
<StackPanel Orientation="Horizontal"><Image Source="Assets/logo.png" Width="72" Height="72"/><StackPanel Margin="16,5"><TextBlock FontSize="32" FontWeight="Bold"><Run Text="DADWAY " Foreground="{StaticResource Yellow}"/><Run Text="VPN" Foreground="{StaticResource Red}"/></TextBlock><TextBlock Text="Windows 10 • стабильный клиент v2.0" Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel></StackPanel>
<Border Style="{StaticResource Card}" Margin="0,22,0,16"><StackPanel HorizontalAlignment="Center">
<Button x:Name="ConnectButton" Click="ConnectButton_Click" Width="220" Height="220" Background="#0B1117" BorderBrush="{StaticResource Yellow}" BorderThickness="5" Cursor="Hand">
<Button.Template><ControlTemplate TargetType="Button"><Border CornerRadius="110" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Image Source="Assets/logo.png" Width="92" Height="92"/><TextBlock x:Name="ConnectLabel" Text="ПОДКЛЮЧИТЬ" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
</Button>
<TextBlock x:Name="StatusText" Text="Отключено" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0"/><TextBlock x:Name="SessionText" Text="00:00:00" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
</StackPanel></Border>
<TextBlock Text="Сервер" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
<UniformGrid Columns="3" Rows="1" Margin="0,0,0,16">
<Button x:Name="RussiaButton" Style="{StaticResource FlatButton}" Click="Server_Click" Tag="russia" Margin="0,0,7,0"><StackPanel><TextBlock Text="🇷🇺" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="Россия" FontSize="16" HorizontalAlignment="Center"/></StackPanel></Button>
<Button x:Name="UsaButton" Style="{StaticResource FlatButton}" Click="Server_Click" Tag="usa" Margin="4,0"><StackPanel><TextBlock Text="🇺🇸" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="USA" FontSize="16" HorizontalAlignment="Center"/></StackPanel></Button>
<Button x:Name="NetherlandsButton" Style="{StaticResource FlatButton}" Click="Server_Click" Tag="netherlands" Margin="7,0,0,0"><StackPanel><TextBlock Text="🇳🇱" FontSize="34" HorizontalAlignment="Center"/><TextBlock Text="Netherlands" FontSize="16" HorizontalAlignment="Center"/></StackPanel></Button>
</UniformGrid>
<UniformGrid Columns="4" Margin="0,0,0,16">
<Border Style="{StaticResource Card}" Margin="0,0,5,0"><StackPanel><TextBlock Text="ВНЕШНИЙ IP" Foreground="{StaticResource Muted}"/><TextBlock x:Name="IpText" Text="—" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="PING" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PingText" Text="— мс" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="3,0"><StackPanel><TextBlock Text="DOWNLOAD" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DownloadText" Text="— Мбит/с" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="5,0,0,0"><StackPanel><TextBlock Text="СЕРВЕР" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ServerText" Text="Россия" FontSize="18" Margin="0,7,0,0"/></StackPanel></Border>
</UniformGrid>
<UniformGrid Columns="4"><Button Style="{StaticResource FlatButton}" Click="Test_Click" Margin="0,0,5,0">Тест</Button><Button Style="{StaticResource FlatButton}" Click="ExportLogs_Click" Margin="3,0">Экспорт логов</Button><Button Style="{StaticResource FlatButton}" Click="Site_Click" Margin="3,0">dadway.ru</Button><Button Style="{StaticResource FlatButton}" Click="Telegram_Click" Margin="5,0,0,0">Telegram</Button></UniformGrid>
</StackPanel></ScrollViewer>
<Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="ЖУРНАЛ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Yellow}"/><TextBlock Text="События подключения и диагностики" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
<TextBox x:Name="LogBox" Grid.Row="1" Margin="0,14" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#090E13" Foreground="#C9D2DC" BorderThickness="0" Padding="10"/>
<StackPanel Grid.Row="2">
<CheckBox x:Name="SystemProxyCheck" Content="Системный прокси Windows" IsChecked="True" Foreground="White" Margin="0,4"/>
<CheckBox x:Name="AutoReconnectCheck" Content="Автопереподключение" IsChecked="True" Foreground="White" Margin="0,4"/>
<CheckBox x:Name="AutoFallbackCheck" Content="Автопереход Россия → USA" IsChecked="True" Foreground="White" Margin="0,4"/>
<CheckBox x:Name="AutoStartCheck" Content="Запускать с Windows" Foreground="White" Margin="0,4" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
<TextBlock Text="Режим: Xray Core + системный HTTP/SOCKS-прокси. Домены .ru, .by и .su идут напрямую." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></Grid></Border>
</Grid></Window>
