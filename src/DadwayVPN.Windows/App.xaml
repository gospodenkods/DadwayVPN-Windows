<Application x:Class="DadwayVPN.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="BgColor">#080C11</Color>
        <Color x:Key="PanelColor">#111820</Color>
        <Color x:Key="Panel2Color">#18212B</Color>
        <Color x:Key="YellowColor">#FFD000</Color>
        <Color x:Key="RedColor">#FF3B30</Color>
        <Color x:Key="GreenColor">#26D95C</Color>
        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="Panel2" Color="{StaticResource Panel2Color}"/>
        <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}"/>
        <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="Muted" Color="#8B98A7"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#273442"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="BorderBrush" Value="#354150"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22303D"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
