<Application x:Class="DadwayVPN.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="BgColor">#0B1118</Color>
        <Color x:Key="PanelColor">#141C25</Color>
        <Color x:Key="PanelHoverColor">#1A2531</Color>
        <Color x:Key="YellowColor">#FFC400</Color>
        <Color x:Key="RedColor">#FF3B30</Color>
        <Color x:Key="GreenColor">#27D845</Color>
        <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelHover" Color="{StaticResource PanelHoverColor}"/>
        <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}"/>
        <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="#354150"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PanelHover}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
